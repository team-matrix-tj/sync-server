NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sync_server?schema=public
STORAGE_ROOT=./storage
DEVICE_TOKEN_PEPPER=replace-me-with-a-long-random-secret
SYNC_PULL_LIMIT=100
SYNC_MAX_BATCH_SIZE=100
SYNC_MAX_FILE_SIZE_BYTES=5242880
LOG_LEVEL=log,error,warn,debug
